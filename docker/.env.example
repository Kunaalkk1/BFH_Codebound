# Documentation only. Compose reads real secrets from anythingmcp/.env.
# Required by the verified upstream quickstart:
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
# Existing Codebound application settings:
CODEBOUND_DEMO_TOKEN_A=REPLACE_WITH_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
CODEBOUND_DEMO_TOKEN_B=REPLACE_WITH_DIFFERENT_RANDOM_TOKEN
SANDBOX_MODE=mock
SANDBOX_MAX_CONCURRENT=2
SANDBOX_MAX_RESULT_BYTES=16384
